{
  "dataset": "male-cns:v1.0",
  "graph_directory": "data/processed/male_cns_v1_0_cue_leg",
  "output_directory": "results/cue_leg/v1_0_pilot",
  "task": "symbolic_cue_to_tethered_foreleg_lift",
  "cue_names": ["A", "B", "blank"],
  "assigned_target_legs": ["LF", "RF", null],
  "cue_encoding": "three discrete cue identities; no retinal or optic-lobe simulation",
