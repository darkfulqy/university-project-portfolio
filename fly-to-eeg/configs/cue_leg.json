    "mapping": "fixed_symmetric_motor_population_sum_to_femur_actuator"
  },
  "behavior_criteria": {
    "target_lift_mm": 0.35,
    "non_target_max_displacement_mm": 0.15,
    "return_tolerance_mm": 0.15,
    "blank_max_displacement_mm": 0.15,
    "response_window_after_onset_s": [0.02, 0.5]
  },
  "training": {"episodes": 2400, "learning_rate": 0.12},
  "nuisance": {"input_gain_range": [0.9, 1.1], "onset_jitter_s": [-0.01, 0.0, 0.01]},
  "scope": "engineering proof of concept; no claim of native biological learning or topology superiority"
}
